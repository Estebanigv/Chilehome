# ============================================
# ChileHome - Configuración Apache
# ============================================
# URLs limpias, cache, compresión y seguridad
# 
# IMPORTANTE - ANALITICA:
# Este archivo NO bloquea Google Analytics, 
# Google Tag Manager, Search Console, ni 
# otras herramientas de análisis.
# ============================================

# Habilitar mod_rewrite
RewriteEngine On

# TC-03: Redirigir www → no-www (301 canónico)
RewriteCond %{HTTP_HOST} ^www\.chilehome\.cl$ [NC]
RewriteRule ^(.*)$ https://chilehome.cl/$1 [R=301,L]

# Feed de productos Meta — sirve feed-meta.php como feed-meta.csv
RewriteRule ^feed-meta\.csv$ feed-meta.php [L,QSA]

# Sucursal Puerto Varas retirada — 301 a /nosotros (evita 404 de la URL antigua)
RewriteRule ^sucursales/puerto-varas/?$ /nosotros [R=301,L]

# Detectar si estamos en localhost/chilehome o en produccion
RewriteCond %{REQUEST_URI} ^/chilehome/ [NC]
RewriteRule ^ - [E=BASE:/chilehome/]
RewriteCond %{REQUEST_URI} !^/chilehome/ [NC]
RewriteRule ^ - [E=BASE:/]

# ============================================
# HTTPS (descomentar en produccion)
# ============================================
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ============================================
# URLs LIMPIAS - Ocultar .html
# ============================================

# Redireccionar index.html a la raiz
RewriteCond %{THE_REQUEST} /index\.html [NC]
RewriteRule ^(.*)index\.html$ %{ENV:BASE}$1 [L,R=301]

# Redireccionar cualquier .html a URL sin extension
RewriteCond %{THE_REQUEST} \.html[\s?] [NC]
RewriteRule ^(.*)\.html$ %{ENV:BASE}$1 [L,R=301]

# Servir archivos .html sin necesidad de escribir la extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

# ============================================
# SEGURIDAD - Archivos sensibles
# ============================================
<FilesMatch "^\.">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Proteger explícitamente .env.php (aunque empieza con punto, doble protección)
<FilesMatch "^\.env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "\.(sql|log|bak|old)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Deshabilitar listado de directorios
Options -Indexes

# ============================================
# RENDIMIENTO - Cache
# ============================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType font/woff "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ============================================
# COMPRESION GZIP
# ============================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ============================================
# HEADERS DE SEGURIDAD
# ============================================
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ============================================
# TC-04: CACHÉ CORRECTA (STAGING)
# HTML: revalidar cada hora · Assets estáticos: 1 año immutable
# IMPORTANTE: probar envío de formulario de cotización tras deployar
# ============================================
<FilesMatch "\.html$">
    <IfModule mod_headers.c>
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </IfModule>
</FilesMatch>
<FilesMatch "\.(jpg|jpeg|png|webp|avif|svg|css|js|woff2)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "public, max-age=31536000, immutable"
    </IfModule>
</FilesMatch>
